Macro Charge(c)
  CompilerIf #Z80_TIMED = 1
    Z80Left = Z80Left - (c)
  CompilerEndIf
EndMacro
Macro CountInsn()
  CompilerIf #Z80_TIMED = 1
    CompilerIf #Z80_TRACK_R = 1
      Z80ICount = Z80ICount + 1
    CompilerEndIf
  CompilerEndIf
EndMacro
; X/Y of SCF/CCF: (Q ! F) | A. Q is F when the previous instruction wrote F.
Macro QXY(dst)
  CompilerIf #Z80_Q = 1
    If qm = Z80Left
      dst = Z80A & $28
    Else
      dst = (Z80F | Z80A) & $28
    EndIf
  CompilerElse
    dst = (Z80F | Z80A) & $28
  CompilerEndIf
EndMacro
Macro MemRd(dst, adr)
  CompilerIf #Z80_MEM_HOOKS = 1
    If Z80PageRd((adr) >> 8) <> 0
      dst = Z80MemRead(adr) & 255
    Else
      dst = Z80Mem(adr)
    EndIf
  CompilerElse
    dst = Z80Mem(adr)
  CompilerEndIf
EndMacro
Macro MemWr(adr, val)
  CompilerIf #Z80_MEM_HOOKS = 1
    If Z80PageWr((adr) >> 8) <> 0
      Z80MemWrite(adr, val)
    Else
      Z80Mem(adr) = val
    EndIf
  CompilerElse
    Z80Mem(adr) = val
  CompilerEndIf
EndMacro
Macro Z80RGetM(dst)
  CompilerIf #Z80_TIMED = 1
    CompilerIf #Z80_TRACK_R = 1
      dst = ((Z80RCnt + Z80ICount + 1) & 127) | Z80R7
    CompilerElse
      Z80Error = 3
      Z80Stopped = 1
      Z80PC = (Z80PC - 2) & $FFFF
      Goto Done
    CompilerEndIf
  CompilerElse
    dst = ((Z80RCnt + (Z80Budget - Z80Left - Z80Saved) + 1) & 127) | Z80R7
  CompilerEndIf
EndMacro
Macro Z80RSetM(val)
  Z80R7 = (val) & 128
  CompilerIf #Z80_TIMED = 1
    Z80RCnt = ((val) & 127) - Z80ICount - 1
  CompilerElse
    Z80RCnt = ((val) & 127) - (Z80Budget - Z80Left - Z80Saved) - 1
  CompilerEndIf
EndMacro

  If Z80Ready = 0
    Z80InitTables()
    Z80Ready = 1
  EndIf
  If n <= 0 Or n >= #Z80_QNONE
    ProcedureReturn 0
  EndIf
  If Z80Stopped <> 0
    ProcedureReturn 0
  EndIf
  Z80Budget = n
  Z80Left = n
  Z80Saved = 0
  CompilerIf #Z80_Q = 1
    If Z80QLast <> 0
      qm = n
    Else
      qm = #Z80_QNONE
    EndIf
  CompilerEndIf
  If Z80EiShadow <> 0
    ; The instruction after EI runs before any interrupt is sampled.
    Z80EiShadow = 0
    If n > 1
      Z80Saved = n - 1
      Z80Left = 1
      CompilerIf #Z80_Q = 1
        If qm <> #Z80_QNONE
          qm = 1
        EndIf
      CompilerEndIf
    EndIf
    Z80DOp = Z80Mem(Z80PC)
    Z80PC = (Z80PC + 1) & $FFFF
! goto *z80_base[g_z80dop];
  EndIf
Resume:
  ; ---- interrupt acceptance at an instruction boundary
  If Z80NmiLine <> 0
    Z80NmiLine = 0
    Z80Halted = 0
    Z80IFF2 = Z80IFF1
    Z80IFF1 = 0
    Z80RCnt = Z80RCnt + 1
    n2 = Z80PC
    Z80SP = (Z80SP - 1) & $FFFF
    v = n2 >> 8
    MemWr(Z80SP, v)
    Z80SP = (Z80SP - 1) & $FFFF
    v = n2 & 255
