BnAlu:  ; ADD A,B / XOR C / RLCA / AND D / OR E / SUB H / ADC A,L / CP $55 / JP $100
  Data.a $80,$A9,$07,$A2,$B3,$94,$8D,$FE,$55,$C3,$00,$01
BnAluEnd:
