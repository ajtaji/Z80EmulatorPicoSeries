; Generated by tools/gen_desktop_tests.py from tests/bench_body.pico - do not edit.
; Instruction-mix benchmarks. Untimed builds report guest instructions per
; second (1,000,000 per sample); timed builds report emulated T-states per
; second (10,000,000 per sample). USB service is outside the timed interval.
Global BnStart.i, BnUsed.i, BnUs.i, BnI.i, BnLen.i

Procedure.i BnPortIn(port.i)
  ProcedureReturn $FF
EndProcedure
Procedure BnPortOut(port.i, value.i)
EndProcedure
CompilerIf #Z80_MEM_HOOKS = 1
; One I/O page at $5000 so the hook path exists; the mixes never touch it.
Procedure.i BnMemRead(addr.i)
  ProcedureReturn $FF
EndProcedure
Procedure BnMemWrite(addr.i, value.i)
EndProcedure
CompilerEndIf

Procedure BnLoad(*code, n.i)
  For BnI = 0 To n - 1
    Z80Mem($100 + BnI) = PeekA(*code + BnI) & 255
  Next
EndProcedure

Procedure BnRun(*name, *code, n.i)
  Protected k.i
  Z80Reset()
  For k = 0 To 65535
    Z80Mem(k) = k & 255
  Next
  BnLoad(*code, n)
  Z80PC = $100 : Z80SP = $F000
  Z80HL = $4000 : Z80DE = $8000 : Z80BC = $0102 : Z80IX = $6000 : Z80IY = $7000
  CompilerIf #Z80_TIMED = 1
    BnStart = Micros()
    BnUsed = 0
    While BnUsed < #BN_TSTATES
      BnUsed = BnUsed + Z80Run(#BN_TSTATES - BnUsed)
    Wend
    BnUs = Micros() - BnStart
    SayA(*name) : Say(" T-states=") : Num(BnUsed) : Say(" us=") : Num(BnUs)
    Say(" emulated kHz=") : Num(Rate(BnUsed, BnUs) / 1000) : Eol()
  CompilerElse
    BnStart = Micros()
    BnUsed = Z80Run(#BN_INSNS)
    BnUs = Micros() - BnStart
    SayA(*name) : Say(" instructions=") : Num(BnUsed) : Say(" us=") : Num(BnUs)
    Say(" instructions/s=") : Num(Rate(BnUsed, BnUs)) : Eol()
  CompilerEndIf
  If Z80Stopped <> 0 Or Z80Halted <> 0
    Say("benchmark stopped FAIL") : Eol()
  EndIf
EndProcedure


