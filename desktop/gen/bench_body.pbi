  Data.a $6C,$64,$69,$72,0   ; ldir
BnBlk:  ; LD HL,$4000 / LD DE,$8000 / LD BC,$1000 / LDIR / JP $100
  Data.a $21,$00,$40,$11,$00,$80,$01,$00,$10,$ED,$B0,$C3,$00,$01
BnBlkEnd:
BnNameIdx:
  Data.a $69,$6E,$64,$65,$78,$65,$64,0   ; indexed
BnIdx:  ; LD A,(IX+1) / ADD A,(IY+2) / LD (IX+3),A / BIT 3,(IY+4) / INC IX / JP $100
  Data.a $DD,$7E,$01,$FD,$86,$02,$DD,$77,$03,$FD,$CB,$04,$5E,$DD,$23,$C3,$00,$01
