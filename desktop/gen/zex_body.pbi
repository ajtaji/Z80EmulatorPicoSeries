Global ZexOk.i, ZexErr.i, ZexTotal.i, ZexStart.i, ZexElapsed.i, ZexLen.i, ZexI.i
Global ZexTests.i, ZexCount.i, ZexMillions.i, ZexLast.i

Procedure.i ZexPortIn(port.i)
  ProcedureReturn $FF
EndProcedure

; BDOS stub: OUT (0),A at $FE00 lands here with C = the function.
Procedure ZexPortOut(port.i, value.i)
  Protected p.i, c.i, n.i
  If (port & 255) <> 0
    ProcedureReturn
  EndIf
  c = PeekA(@Z80BC)
  If c = 2
    PutC(PeekA(@Z80DE))
  ElseIf c = 9
    p = Z80DE
    If Z80Mem(p) = 32 And Z80Mem((p + 1) & $FFFF) = 32
      If Z80Mem((p + 2) & $FFFF) = 79
        ZexOk = ZexOk + 1
      ElseIf Z80Mem((p + 2) & $FFFF) = 69
        ZexErr = ZexErr + 1
      EndIf
      ; how long this test took, before its verdict
      Say(" [") : Num((Micros() - ZexLast) / 1000) : Say(" ms]")
      ZexLast = Micros()
    EndIf
    n = 0
    While Z80Mem(p) <> 36 And n < 200
      PutC(Z80Mem(p))
      p = (p + 1) & $FFFF
      n = n + 1
    Wend
    UsbSerialFlush()
  EndIf
EndProcedure

; (millions * 1e6 + units) * 1000 / ms, in 32-bit arithmetic.
Procedure.i BigRate(millions.i, units.i, ms.i)
  Protected a.i, b.i, acc.i, frac.i, i.i
  If ms <= 0
    ProcedureReturn 0
  EndIf
  a = 1000000000 / ms : b = 1000000000 % ms
  acc = millions * a
  frac = 0
  For i = 1 To millions
    frac = frac + b
    While frac >= ms
      frac = frac - ms
      acc = acc + 1
    Wend
  Next
  ProcedureReturn acc + (units * 1000) / ms
EndProcedure

