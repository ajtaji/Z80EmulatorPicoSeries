EndProcedure
Procedure Z80P_Op10()
  Z80L_t = (PeekA(@Z80BC + 1) - 1) & 255
  PokeA(@Z80BC + 1, Z80L_t)
  If Z80L_t <> 0
    Z80L_t = PeekB(@Z80Mem(0) + Z80PC)
    Z80PC = (Z80PC + 1 + Z80L_t) & $FFFF
    Z80WZ = Z80PC
    Charge(5)
  Else
    Z80PC = (Z80PC + 1) & $FFFF
  EndIf
  CountInsn()
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 8
      If Z80Left <= 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerElse
      Z80Left = Z80Left - 1
      If Z80Left = 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure Z80P_Op11()
  Z80DE = Z80Mem(Z80PC) | (Z80Mem((Z80PC + 1) & $FFFF) << 8)
  Z80PC = (Z80PC + 2) & $FFFF
