; PROCEDURE-TABLE VARIANT, for the dispatch measurement only.
; Generated by tools/gen_z80_desktop.py from the handlers of tools/gen_z80.py.
; Edit the generator, then regenerate. Same core as src/z80.pico.
; Zilog Z80 (NMOS) core for PureMetal, the PC (PureBasic x64, C back end).
; All documented and undocumented opcodes, undocumented X/Y flags, MEMPTR,
; Q (SCF/CCF), block instructions, IM 0/1/2, NMI, HALT, EI delay, R.
; Build switches (define before including this file):
;   #Z80_TIMED     = 1  Z80Run's budget and result are T-states;
;                    0  they are whole instructions (prefixes included).
;   (no #Z80_ASM_TAIL here: dispatch is labels-as-values through the C back end)
;   #Z80_MEM_HOOKS = 1  data reads/writes of pages flagged in Z80PageRd/
;                       Z80PageWr call Z80MemRead(addr)/Z80MemWrite(addr,v),
;                       which the machine defines. 0: flat 64 KB only.
;   #Z80_Q         = 1  model the Q latch for SCF/CCF X/Y bits (default 1).
;   #Z80_SHARED_TAIL = 1  one shared dispatch tail (smaller, a branch slower);
;                    0  every handler carries its own tail (fastest).
;   #Z80_TRACK_R   = 1  exact R in timed builds (one counter per instruction);
;                       0  LD A,R stops the CPU with Z80Error = 3.
; The machine always defines Z80PortIn(port) and Z80PortOut(port, value).
; Opcode and operand fetches always read Z80Mem directly.
; See README.md for the API.

EnableExplicit
#Z80_QNONE = $7FFFFFFF
Global Dim Z80Mem.a(65536)
CompilerIf #Z80_MEM_HOOKS = 1
  Global Dim Z80PageRd.a(256)
  Global Dim Z80PageWr.a(256)
  Declare.i Z80MemRead(addr.i)
  Declare Z80MemWrite(addr.i, value.i)
CompilerEndIf
Declare.i Z80PortIn(port.i)
Declare Z80PortOut(port.i, value.i)
Global Dim Z80SZ53.a(256)
Global Dim Z80SZ53P.a(256)
Global Dim Z80IncF.a(256)
Global Dim Z80DecF.a(256)
Global Dim Z80HVC.a(32)
Global Dim Z80HVCN.a(32)
Global Z80PC.i, Z80A.i, Z80F.i, Z80Left.i
Global Z80BC.i, Z80DE.i, Z80HL.i, Z80IX.i, Z80IY.i, Z80SP.i, Z80WZ.i
Global Z80AF2.i, Z80BC2.i, Z80DE2.i, Z80HL2.i
Global Z80I.i, Z80R7.i, Z80RCnt.i, Z80ICount.i, Z80IM.i, Z80IFF1.i, Z80IFF2.i
Global Z80Halted.i, Z80IntLine.i, Z80IntData.i, Z80NmiLine.i, Z80EiShadow.i
Global Z80Stopped.i, Z80Error.i, Z80TStates.i, Z80QLast.i
Global Z80Budget.i, Z80Saved.i, Z80Ready.i, Z80InitI.i
Global Z80DOp.i   ; the byte a computed jump indexes with

; ---- flag tables, reset, interrupts ------------------------------------
Procedure Z80InitTables()
  Protected i.i, j.i, p.i, f.i
  For i = 0 To 255
    p = 0
    For j = 0 To 7
      p = p ! ((i >> j) & 1)
    Next
    f = (i & $A8)
    If i = 0
      f = f | 64
    EndIf
    Z80SZ53(i) = f
    If p = 0
      Z80SZ53P(i) = f | 4
    Else
      Z80SZ53P(i) = f
    EndIf
    f = Z80SZ53(i)
    If (i & 15) = 0
      f = f | 16
    EndIf
    If i = $80
      f = f | 4
    EndIf
    Z80IncF(i) = f
    f = Z80SZ53(i) | 2
    If (i & 15) = 15
      f = f | 16
    EndIf
    If i = $7F
      f = f | 4
    EndIf
    Z80DecF(i) = f
  Next
  ; H|V|C from bits 4..8 of (a ! b ! result): bit 0 is H (carry into bit 4),
  ; bit 4 is C (carry out of bit 7), bit 3 ! bit 4 is V.
  For i = 0 To 31
    f = (i & 1) << 4
    f = f | ((i >> 4) & 1)
    If (((i >> 3) ! (i >> 4)) & 1) <> 0
      f = f | 4
    EndIf
    Z80HVC(i) = f
    Z80HVCN(i) = f | 2
  Next
EndProcedure

; Power-on state. Memory is not touched.
Procedure Z80Reset()
  If Z80Ready = 0
    Z80InitTables()
  EndIf
  Z80PC = 0 : Z80SP = $FFFF : Z80A = $FF : Z80F = $FF
  Z80BC = 0 : Z80DE = 0 : Z80HL = 0 : Z80IX = $FFFF : Z80IY = $FFFF
  Z80AF2 = $FFFF : Z80BC2 = 0 : Z80DE2 = 0 : Z80HL2 = 0 : Z80WZ = 0
  Z80I = 0 : Z80R7 = 0 : Z80RCnt = 0 : Z80ICount = 0 : Z80IM = 0
  Z80IFF1 = 0 : Z80IFF2 = 0 : Z80Halted = 0 : Z80EiShadow = 0
  Z80IntLine = 0 : Z80IntData = $FF : Z80NmiLine = 0
  Z80Stopped = 0 : Z80Error = 0 : Z80TStates = 0 : Z80QLast = 0
EndProcedure

; Maskable interrupt request with the byte the device puts on the bus
; (the IM 2 vector low byte, or an RST opcode for IM 0). It is held until
; the CPU accepts it, then cleared (HOLD_LINE). Z80IntClear() drops it.
Procedure Z80IntRequest(busbyte.i)
  Z80IntData = busbyte & 255
  Z80IntLine = 1
EndProcedure
Procedure Z80IntClear()
  Z80IntLine = 0
EndProcedure
; Non-maskable interrupt (edge): accepted at the next instruction boundary
; Z80Run reaches.
Procedure Z80NmiRequest()
  Z80NmiLine = 1
EndProcedure

; The R register as the CPU would read it now.
Procedure.i Z80GetR()
  CompilerIf #Z80_TIMED = 1
    ProcedureReturn ((Z80RCnt + Z80ICount) & 127) | Z80R7
  CompilerElse
    ProcedureReturn (Z80RCnt & 127) | Z80R7
  CompilerEndIf
EndProcedure
Procedure Z80SetR(v.i)
  Z80R7 = v & 128
  CompilerIf #Z80_TIMED = 1
    Z80RCnt = (v & 127) - Z80ICount
  CompilerElse
    Z80RCnt = v & 127
  CompilerEndIf
EndProcedure

Global Z80L_op.i, Z80L_t.i, Z80L_v.i, Z80L_ea.i, Z80L_r.i, Z80L_n2.i, Z80L_qm.i, Z80Brk.i
Global Dim Z80PBase.i(256), Dim Z80PCB.i(256), Dim Z80PED.i(256), Dim Z80PDD.i(256)
Global Dim Z80PFD.i(256), Dim Z80PXCB.i(32), Dim Z80PXCopy.i(16)

Macro Charge(c)
  CompilerIf #Z80_TIMED = 1
    Z80Left = Z80Left - (c)
  CompilerEndIf
EndMacro
Macro CountInsn()
  CompilerIf #Z80_TIMED = 1
    CompilerIf #Z80_TRACK_R = 1
      Z80ICount = Z80ICount + 1
    CompilerEndIf
  CompilerEndIf
EndMacro
; X/Y of SCF/CCF: (Q ! F) | A. Q is F when the previous instruction wrote F.
Macro QXY(dst)
  CompilerIf #Z80_Q = 1
    If Z80L_qm = Z80Left
      dst = Z80A & $28
    Else
      dst = (Z80F | Z80A) & $28
    EndIf
  CompilerElse
    dst = (Z80F | Z80A) & $28
  CompilerEndIf
EndMacro
Macro MemRd(dst, adr)
  CompilerIf #Z80_MEM_HOOKS = 1
    If Z80PageRd((adr) >> 8) <> 0
      dst = Z80MemRead(adr) & 255
    Else
      dst = Z80Mem(adr)
    EndIf
  CompilerElse
    dst = Z80Mem(adr)
  CompilerEndIf
EndMacro
Macro MemWr(adr, val)
  CompilerIf #Z80_MEM_HOOKS = 1
    If Z80PageWr((adr) >> 8) <> 0
      Z80MemWrite(adr, val)
    Else
      Z80Mem(adr) = val
    EndIf
  CompilerElse
    Z80Mem(adr) = val
  CompilerEndIf
EndMacro
Macro Z80RGetM(dst)
  CompilerIf #Z80_TIMED = 1
    CompilerIf #Z80_TRACK_R = 1
      dst = ((Z80RCnt + Z80ICount + 1) & 127) | Z80R7
    CompilerElse
      Z80Error = 3
      Z80Stopped = 1
      Z80PC = (Z80PC - 2) & $FFFF
      Z80Brk = 1 : ProcedureReturn
    CompilerEndIf
  CompilerElse
    dst = ((Z80RCnt + (Z80Budget - Z80Left - Z80Saved) + 1) & 127) | Z80R7
  CompilerEndIf
EndMacro
Macro Z80RSetM(val)
  Z80R7 = (val) & 128
  CompilerIf #Z80_TIMED = 1
    Z80RCnt = ((val) & 127) - Z80ICount - 1
  CompilerElse
    Z80RCnt = ((val) & 127) - (Z80Budget - Z80Left - Z80Saved) - 1
  CompilerEndIf
EndMacro

Procedure Z80P_PfxCB()
  Z80RCnt = Z80RCnt + 1
  Z80DOp = Z80Mem(Z80PC)
  Z80PC = (Z80PC + 1) & $FFFF
  CallFunctionFast(Z80PCB(Z80DOp))
EndProcedure
Procedure Z80P_PfxED()
  Z80RCnt = Z80RCnt + 1
  Z80DOp = Z80Mem(Z80PC)
  Z80PC = (Z80PC + 1) & $FFFF
  CallFunctionFast(Z80PED(Z80DOp))
EndProcedure
Procedure Z80P_PfxDD()
  Z80L_qm = #Z80_QNONE   ; the prefix is an M1 that writes no flags: Q = 0
  Z80RCnt = Z80RCnt + 1
  Z80DOp = Z80Mem(Z80PC)
  Z80PC = (Z80PC + 1) & $FFFF
  CallFunctionFast(Z80PDD(Z80DOp))
EndProcedure
Procedure Z80P_PfxFD()
  Z80L_qm = #Z80_QNONE   ; the prefix is an M1 that writes no flags: Q = 0
  Z80RCnt = Z80RCnt + 1
  Z80DOp = Z80Mem(Z80PC)
  Z80PC = (Z80PC + 1) & $FFFF
  CallFunctionFast(Z80PFD(Z80DOp))
; A prefix after DD/FD: the first one was a 4 T-state NOP.
EndProcedure
Procedure Z80P_PfxDDc()
  Z80L_qm = #Z80_QNONE   ; the prefix is an M1 that writes no flags: Q = 0
  Charge(4)
  Z80RCnt = Z80RCnt + 1
  Z80DOp = Z80Mem(Z80PC)
  Z80PC = (Z80PC + 1) & $FFFF
  CallFunctionFast(Z80PDD(Z80DOp))
EndProcedure
Procedure Z80P_PfxFDc()
  Z80L_qm = #Z80_QNONE   ; the prefix is an M1 that writes no flags: Q = 0
  Charge(4)
  Z80RCnt = Z80RCnt + 1
  Z80DOp = Z80Mem(Z80PC)
  Z80PC = (Z80PC + 1) & $FFFF
  CallFunctionFast(Z80PFD(Z80DOp))
EndProcedure
Procedure Z80P_PfxEDc()
  Charge(4)
  Z80RCnt = Z80RCnt + 1
  Z80DOp = Z80Mem(Z80PC)
  Z80PC = (Z80PC + 1) & $FFFF
  CallFunctionFast(Z80PED(Z80DOp))
; DD/FD before an opcode that does not use HL: the base opcode plus 4 T.
EndProcedure
Procedure Z80P_XPass()
  Charge(4)
  Z80DOp = Z80Mem((Z80PC - 1) & $FFFF)
  CallFunctionFast(Z80PBase(Z80DOp))
EndProcedure
Procedure Z80P_PfxXCBIX()
  Z80L_ea = (Z80IX + PeekB(@Z80Mem(0) + Z80PC)) & $FFFF
  Z80PC = (Z80PC + 1) & $FFFF
  Z80WZ = Z80L_ea
  Z80DOp = Z80Mem(Z80PC)
  Z80PC = (Z80PC + 1) & $FFFF
  CallFunctionFast(Z80PXCB(Z80DOp >> 3))
EndProcedure
Procedure Z80P_PfxXCBIY()
  Z80L_ea = (Z80IY + PeekB(@Z80Mem(0) + Z80PC)) & $FFFF
  Z80PC = (Z80PC + 1) & $FFFF
  Z80WZ = Z80L_ea
  Z80DOp = Z80Mem(Z80PC)
  Z80PC = (Z80PC + 1) & $FFFF
  CallFunctionFast(Z80PXCB(Z80DOp >> 3))
EndProcedure
Procedure Z80P_EDNop()
  CountInsn()
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 8
      If Z80Left <= 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerElse
      Z80Left = Z80Left - 1
      If Z80Left = 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure Z80P_Op00()
  CountInsn()
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 4
      If Z80Left <= 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerElse
      Z80Left = Z80Left - 1
      If Z80Left = 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure Z80P_Op01()
  Z80BC = Z80Mem(Z80PC) | (Z80Mem((Z80PC + 1) & $FFFF) << 8)
  Z80PC = (Z80PC + 2) & $FFFF
  CountInsn()
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 10
      If Z80Left <= 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerElse
      Z80Left = Z80Left - 1
      If Z80Left = 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure Z80P_Op02()
  Z80L_ea = Z80BC
  MemWr(Z80L_ea, Z80A)
  Z80WZ = ((Z80L_ea + 1) & 255) | (Z80A << 8)
  CountInsn()
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 7
      If Z80Left <= 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerElse
      Z80Left = Z80Left - 1
      If Z80Left = 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure Z80P_Op03()
  Z80BC = (Z80BC + 1) & $FFFF
  CountInsn()
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 6
      If Z80Left <= 0
