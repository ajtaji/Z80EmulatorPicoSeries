EndProcedure
Procedure Z80P_Op04()
  Z80L_v = PeekA(@Z80BC + 1)
  Z80L_r = (Z80L_v + 1) & 255
  Z80F = (Z80F & 1) | Z80IncF(Z80L_r)
  PokeA(@Z80BC + 1, Z80L_r)
  CompilerIf #Z80_Q = 1
    CompilerIf #Z80_TIMED = 1
      Z80L_qm = Z80Left - 4
    CompilerElse
      Z80L_qm = Z80Left - 1
    CompilerEndIf
  CompilerEndIf
  CountInsn()
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 4
      If Z80Left <= 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerElse
      Z80Left = Z80Left - 1
      If Z80Left = 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure Z80P_Op05()
  Z80L_v = PeekA(@Z80BC + 1)
  Z80L_r = (Z80L_v - 1) & 255
  Z80F = (Z80F & 1) | Z80DecF(Z80L_r)
  PokeA(@Z80BC + 1, Z80L_r)
  CompilerIf #Z80_Q = 1
    CompilerIf #Z80_TIMED = 1
      Z80L_qm = Z80Left - 4
    CompilerElse
      Z80L_qm = Z80Left - 1
    CompilerEndIf
  CompilerEndIf
  CountInsn()
    CompilerIf #Z80_TIMED = 1
