    CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure Z80P_Op09()
  Z80L_v = Z80BC
  Z80WZ = (Z80HL + 1) & $FFFF
  Z80L_r = Z80HL + Z80L_v
  Z80L_t = Z80HL ! Z80L_v ! Z80L_r
  Z80F = (Z80F & $C4) | ((Z80L_r >> 8) & $28) | (Z80HVC((Z80L_t >> 12) & 31) & 17)
  Z80HL = Z80L_r & $FFFF
  CompilerIf #Z80_Q = 1
    CompilerIf #Z80_TIMED = 1
      Z80L_qm = Z80Left - 11
    CompilerElse
      Z80L_qm = Z80Left - 1
    CompilerEndIf
  CompilerEndIf
  CountInsn()
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 11
      If Z80Left <= 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerElse
      Z80Left = Z80Left - 1
      If Z80Left = 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerEndIf
  ProcedureReturn
EndProcedure
