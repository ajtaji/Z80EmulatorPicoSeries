      EndIf
    CompilerElse
      Z80Left = Z80Left - 1
      If Z80Left = 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerEndIf
  ProcedureReturn
EndProcedure
Procedure Z80P_Op08()
  Z80L_t = (Z80A << 8) | Z80F
  Z80A = Z80AF2 >> 8
  Z80F = Z80AF2 & 255
  Z80AF2 = Z80L_t
  CountInsn()
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 4
      If Z80Left <= 0
        Z80Brk = 1
        ProcedureReturn
      EndIf
    CompilerElse
      Z80Left = Z80Left - 1
