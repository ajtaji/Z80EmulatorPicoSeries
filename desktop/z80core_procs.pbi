    Z80PXCopy(0) = @Z80P_XCpy00()
    Z80PXCopy(1) = @Z80P_XCpy01()
    Z80PXCopy(2) = @Z80P_XCpy02()
    Z80PXCopy(3) = @Z80P_XCpy03()
    Z80PXCopy(4) = @Z80P_XCpy04()
    Z80PXCopy(5) = @Z80P_XCpy05()
    Z80PXCopy(6) = @Z80P_XCpy06()
    Z80PXCopy(7) = @Z80P_XCpy07()
    Z80PXCopy(8) = @Z80P_XCpy08()
    Z80PXCopy(9) = @Z80P_XCpy09()
    Z80PXCopy(10) = @Z80P_XCpy10()
    Z80PXCopy(11) = @Z80P_XCpy11()
    Z80PXCopy(12) = @Z80P_XCpy12()
    Z80PXCopy(13) = @Z80P_XCpy13()
    Z80PXCopy(14) = @Z80P_XCpy14()
    Z80PXCopy(15) = @Z80P_XCpy15()
    Z80Ready = 1
  EndIf
  If n <= 0 Or n >= #Z80_QNONE
    ProcedureReturn 0
  EndIf
  If Z80Stopped <> 0
    ProcedureReturn 0
  EndIf
  Z80Budget = n
  Z80Left = n
  Z80Saved = 0
  CompilerIf #Z80_Q = 1
    If Z80QLast <> 0
      Z80L_qm = n
    Else
      Z80L_qm = #Z80_QNONE
    EndIf
  CompilerEndIf
  If Z80EiShadow <> 0
    ; The instruction after EI runs before any interrupt is sampled.
    Z80EiShadow = 0
    If n > 1
      Z80Saved = n - 1
      Z80Left = 1
      CompilerIf #Z80_Q = 1
        If Z80L_qm <> #Z80_QNONE
          Z80L_qm = 1
        EndIf
      CompilerEndIf
    EndIf
    Goto FetchLoop
  EndIf
Resume:
  ; ---- interrupt acceptance at an instruction boundary
  If Z80NmiLine <> 0
    Z80NmiLine = 0
    Z80Halted = 0
    Z80IFF2 = Z80IFF1
    Z80IFF1 = 0
    Z80RCnt = Z80RCnt + 1
    Z80L_n2 = Z80PC
    Z80SP = (Z80SP - 1) & $FFFF
    Z80L_v = Z80L_n2 >> 8
    MemWr(Z80SP, Z80L_v)
    Z80SP = (Z80SP - 1) & $FFFF
    Z80L_v = Z80L_n2 & 255
    MemWr(Z80SP, Z80L_v)
    Z80PC = $66
    Z80WZ = Z80PC
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 11
    CompilerEndIf
    Z80L_qm = #Z80_QNONE
  ElseIf (Z80IntLine <> 0) And (Z80IFF1 <> 0)
    Z80IntLine = 0
    Z80Halted = 0
    Z80IFF1 = 0
    Z80IFF2 = 0
    Z80RCnt = Z80RCnt + 1
    Z80L_n2 = Z80PC
    Z80SP = (Z80SP - 1) & $FFFF
    Z80L_v = Z80L_n2 >> 8
    MemWr(Z80SP, Z80L_v)
    Z80SP = (Z80SP - 1) & $FFFF
    Z80L_v = Z80L_n2 & 255
    MemWr(Z80SP, Z80L_v)
    If Z80IM = 2
      Z80L_ea = (Z80I << 8) | Z80IntData
      MemRd(Z80L_n2, Z80L_ea)
      Z80L_t = (Z80L_ea + 1) & $FFFF
      MemRd(Z80L_v, Z80L_t)
      Z80L_n2 = Z80L_n2 | (Z80L_v << 8)
      Z80PC = Z80L_n2
      CompilerIf #Z80_TIMED = 1
        Z80Left = Z80Left - 19
      CompilerEndIf
    ElseIf Z80IM = 1
      Z80PC = $38
      CompilerIf #Z80_TIMED = 1
        Z80Left = Z80Left - 13
      CompilerEndIf
    Else
      If (Z80IntData & $C7) = $C7
        Z80PC = Z80IntData & $38
        CompilerIf #Z80_TIMED = 1
          Z80Left = Z80Left - 13
        CompilerEndIf
      Else
        ; IM 0 with a data byte that is not RST: not modelled. Stop loudly.
        Z80SP = (Z80SP + 2) & $FFFF
        Z80Error = 2
        Z80Stopped = 1
        Goto Done
      EndIf
    EndIf
    Z80WZ = Z80PC
    Z80L_qm = #Z80_QNONE
  EndIf
  If Z80Halted <> 0
    ; HALT executes NOPs (4 T-states, one R step each) until an interrupt.
    If Z80Left > 0
      CompilerIf #Z80_TIMED = 1
        Z80L_t = (Z80Left + 3) >> 2
        Z80RCnt = Z80RCnt + Z80L_t
        Z80Left = Z80Left - (Z80L_t << 2)
      CompilerElse
        Z80Left = 0
      CompilerEndIf
    EndIf
    Z80L_qm = #Z80_QNONE
    Goto Done
  EndIf
  If Z80Left <= 0
    Goto Done
  EndIf
  Goto FetchLoop

; Shared instruction tails (#Z80_SHARED_TAIL = 1): one copy of the dispatch.
FetchLoop:
  Repeat
    Z80DOp = Z80Mem(Z80PC)
    Z80PC = (Z80PC + 1) & $FFFF
    CallFunctionFast(Z80PBase(Z80DOp))
  Until Z80Left <= 0 Or Z80Brk <> 0
  If Z80Brk = 2
    Z80Brk = 0
    Goto Resume
  EndIf
  Z80Brk = 0
Done:
  If Z80Saved <> 0
    ; End of an EI window split: give back the budget and sample interrupts.
    CompilerIf #Z80_Q = 1
      If Z80L_qm = Z80Left
        Z80L_qm = Z80Left + Z80Saved
      Else
        Z80L_qm = #Z80_QNONE
      EndIf
    CompilerEndIf
    Z80Left = Z80Left + Z80Saved
    Z80Saved = 0
    If Z80Stopped = 0
      If Z80Left > 0
        Goto Resume
      EndIf
    EndIf
  EndIf
  CompilerIf #Z80_Q = 1
    If Z80L_qm = Z80Left
      Z80QLast = 1
    Else
      Z80QLast = 0
    EndIf
  CompilerEndIf
  Z80L_t = Z80Budget - Z80Left
  CompilerIf #Z80_TIMED = 1
    Z80TStates = Z80TStates + Z80L_t
    Z80RCnt = Z80RCnt + Z80ICount
    Z80ICount = 0
  CompilerElse
    Z80RCnt = Z80RCnt + Z80L_t
  CompilerEndIf
  ProcedureReturn Z80L_t
EndProcedure

