  ProcedureReturn
EndProcedure
Procedure Z80P_Op06()
  Z80L_v = Z80Mem(Z80PC)
  Z80PC = (Z80PC + 1) & $FFFF
  PokeA(@Z80BC + 1, Z80L_v)
  CountInsn()
    CompilerIf #Z80_TIMED = 1
