EndProcedure
Procedure Z80P_Op07()
  Z80A = ((Z80A << 1) | (Z80A >> 7)) & 255
  Z80F = (Z80F & $C4) | (Z80A & $29)
  CompilerIf #Z80_Q = 1
    CompilerIf #Z80_TIMED = 1
      Z80L_qm = Z80Left - 4
    CompilerElse
      Z80L_qm = Z80Left - 1
    CompilerEndIf
  CompilerEndIf
  CountInsn()
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 4
      If Z80Left <= 0
        Z80Brk = 1
