Procedure Z80P_Op0F()
  Z80L_t = Z80A & 1
  Z80A = (Z80A >> 1) | (Z80L_t << 7)
  Z80F = (Z80F & $C4) | (Z80A & $28) | Z80L_t
  CompilerIf #Z80_Q = 1
    CompilerIf #Z80_TIMED = 1
      Z80L_qm = Z80Left - 4
    CompilerElse
      Z80L_qm = Z80Left - 1
    CompilerEndIf
  CompilerEndIf
  CountInsn()
    CompilerIf #Z80_TIMED = 1
