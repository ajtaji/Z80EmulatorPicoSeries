    Z80OpFD(105) = ?IYOp69
    Z80OpFD(106) = ?IYOp6A
    Z80OpFD(107) = ?IYOp6B
    Z80OpFD(108) = ?IYOp6C
    Z80OpFD(109) = ?IYOp6D
    Z80OpFD(110) = ?IYOp6E
    Z80OpFD(111) = ?IYOp6F
    Z80OpFD(112) = ?IYOp70
    Z80OpFD(113) = ?IYOp71
    Z80OpFD(114) = ?IYOp72
    Z80OpFD(115) = ?IYOp73
    Z80OpFD(116) = ?IYOp74
    Z80OpFD(117) = ?IYOp75
    Z80OpFD(119) = ?IYOp77
    Z80OpFD(124) = ?IYOp7C
    Z80OpFD(125) = ?IYOp7D
    Z80OpFD(126) = ?IYOp7E
    Z80OpFD(132) = ?IYOp84
    Z80OpFD(133) = ?IYOp85
    Z80OpFD(134) = ?IYOp86
    Z80OpFD(140) = ?IYOp8C
    Z80OpFD(141) = ?IYOp8D
    Z80OpFD(142) = ?IYOp8E
    Z80OpFD(148) = ?IYOp94
    Z80OpFD(149) = ?IYOp95
    Z80OpFD(150) = ?IYOp96
    Z80OpFD(156) = ?IYOp9C
    Z80OpFD(157) = ?IYOp9D
    Z80OpFD(158) = ?IYOp9E
    Z80OpFD(164) = ?IYOpA4
    Z80OpFD(165) = ?IYOpA5
    Z80OpFD(166) = ?IYOpA6
    Z80OpFD(172) = ?IYOpAC
    Z80OpFD(173) = ?IYOpAD
    Z80OpFD(174) = ?IYOpAE
    Z80OpFD(180) = ?IYOpB4
    Z80OpFD(181) = ?IYOpB5
    Z80OpFD(182) = ?IYOpB6
    Z80OpFD(188) = ?IYOpBC
    Z80OpFD(189) = ?IYOpBD
    Z80OpFD(190) = ?IYOpBE
    Z80OpFD(203) = ?PfxXCBIY
    Z80OpFD(221) = ?PfxDDc
    Z80OpFD(225) = ?IYOpE1
    Z80OpFD(227) = ?IYOpE3
    Z80OpFD(229) = ?IYOpE5
    Z80OpFD(233) = ?IYOpE9
    Z80OpFD(237) = ?PfxEDc
    Z80OpFD(249) = ?IYOpF9
    Z80OpFD(253) = ?PfxFDc
    Z80Ready = 1
  EndIf
  If n <= 0 Or n >= #Z80_QNONE
    ProcedureReturn 0
  EndIf
  If Z80Stopped <> 0
    ProcedureReturn 0
  EndIf
  Z80Budget = n
  Z80Left = n
  Z80Saved = 0
  CompilerIf #Z80_Q = 1
    If Z80QLast <> 0
      qm = n
    Else
      qm = #Z80_QNONE
    EndIf
  CompilerEndIf
  If Z80EiShadow <> 0
    ; The instruction after EI runs before any interrupt is sampled.
    Z80EiShadow = 0
    If n > 1
      Z80Saved = n - 1
      Z80Left = 1
      CompilerIf #Z80_Q = 1
        If qm <> #Z80_QNONE
          qm = 1
        EndIf
      CompilerEndIf
    EndIf
    DispatchBase()
  EndIf
Resume:
  ; ---- interrupt acceptance at an instruction boundary
  If Z80NmiLine <> 0
    Z80NmiLine = 0
    Z80Halted = 0
    Z80IFF2 = Z80IFF1
    Z80IFF1 = 0
    Z80RCnt = Z80RCnt + 1
    n2 = Z80PC
    Z80SP = (Z80SP - 1) & $FFFF
    v = n2 >> 8
    MemWr(Z80SP, v)
    Z80SP = (Z80SP - 1) & $FFFF
    v = n2 & 255
    MemWr(Z80SP, v)
    Z80PC = $66
    Z80WZ = Z80PC
    CompilerIf #Z80_TIMED = 1
      Z80Left = Z80Left - 11
    CompilerEndIf
    qm = #Z80_QNONE
  ElseIf (Z80IntLine <> 0) And (Z80IFF1 <> 0)
    Z80IntLine = 0
    Z80Halted = 0
    Z80IFF1 = 0
    Z80IFF2 = 0
    Z80RCnt = Z80RCnt + 1
    n2 = Z80PC
    Z80SP = (Z80SP - 1) & $FFFF
    v = n2 >> 8
    MemWr(Z80SP, v)
    Z80SP = (Z80SP - 1) & $FFFF
    v = n2 & 255
    MemWr(Z80SP, v)
    If Z80IM = 2
      ea = (Z80I << 8) | Z80IntData
      MemRd(n2, ea)
      t = (ea + 1) & $FFFF
      MemRd(v, t)
      n2 = n2 | (v << 8)
      Z80PC = n2
      CompilerIf #Z80_TIMED = 1
        Z80Left = Z80Left - 19
      CompilerEndIf
    ElseIf Z80IM = 1
      Z80PC = $38
      CompilerIf #Z80_TIMED = 1
        Z80Left = Z80Left - 13
      CompilerEndIf
    Else
      If (Z80IntData & $C7) = $C7
        Z80PC = Z80IntData & $38
        CompilerIf #Z80_TIMED = 1
          Z80Left = Z80Left - 13
        CompilerEndIf
      Else
        ; IM 0 with a data byte that is not RST: not modelled. Stop loudly.
        Z80SP = (Z80SP + 2) & $FFFF
        Z80Error = 2
        Z80Stopped = 1
        Goto Done
      EndIf
    EndIf
    Z80WZ = Z80PC
    qm = #Z80_QNONE
  EndIf
  If Z80Halted <> 0
    ; HALT executes NOPs (4 T-states, one R step each) until an interrupt.
    If Z80Left > 0
      CompilerIf #Z80_TIMED = 1
        t = (Z80Left + 3) >> 2
        Z80RCnt = Z80RCnt + t
        Z80Left = Z80Left - (t << 2)
      CompilerElse
        Z80Left = 0
      CompilerEndIf
    EndIf
    qm = #Z80_QNONE
    Goto Done
  EndIf
  If Z80Left <= 0
    Goto Done
  EndIf
  DispatchBase()

; Shared instruction tails (#Z80_SHARED_TAIL = 1): one copy of the dispatch.
NextShared:
  CompilerIf #Z80_ASM_TAIL = 1
    ASM Uses Z80Left
      mov r0, r11
      subs r0, #1
      mov r11, r0
      beq __ul_z80run_done
    EndASM
  CompilerElse
    Z80Left = Z80Left - 1
    If Z80Left = 0
      Goto Done
    EndIf
  CompilerEndIf
DispShared:
  CountInsn()
  DispatchBase()
; Shared timed tail: the instruction that spent the budget, counted here.
DoneCnt:
  CountInsn()
  Goto Done
PfxCB:
  Z80RCnt = Z80RCnt + 1
  DispatchCB()
PfxED:
  Z80RCnt = Z80RCnt + 1
  DispatchED()
PfxDD:
  qm = #Z80_QNONE   ; the prefix is an M1 that writes no flags: Q = 0
  Z80RCnt = Z80RCnt + 1
  DispatchDD()
PfxFD:
  qm = #Z80_QNONE   ; the prefix is an M1 that writes no flags: Q = 0
  Z80RCnt = Z80RCnt + 1
  DispatchFD()
; A prefix after DD/FD: the first one was a 4 T-state NOP.
PfxDDc:
  qm = #Z80_QNONE   ; the prefix is an M1 that writes no flags: Q = 0
  Charge(4)
  Z80RCnt = Z80RCnt + 1
  DispatchDD()
PfxFDc:
  qm = #Z80_QNONE   ; the prefix is an M1 that writes no flags: Q = 0
  Charge(4)
  Z80RCnt = Z80RCnt + 1
  DispatchFD()
PfxEDc:
  Charge(4)
  Z80RCnt = Z80RCnt + 1
  DispatchED()
; DD/FD before an opcode that does not use HL: the base opcode plus 4 T.
XPass:
  Charge(4)
  op = Z80Mem((Z80PC - 1) & $FFFF)
  Goto Z80OpBase(op)
PfxXCBIX:
  ea = (Z80IX + PeekB(@Z80Mem(0) + Z80PC)) & $FFFF
  Z80PC = (Z80PC + 1) & $FFFF
  Z80WZ = ea
  DispatchXCB()
PfxXCBIY:
  ea = (Z80IY + PeekB(@Z80Mem(0) + Z80PC)) & $FFFF
  Z80PC = (Z80PC + 1) & $FFFF
  Z80WZ = ea
  DispatchXCB()
EDNop: ; undefined ED xx: an 8 T-state NOP
  CompilerIf #Z80_SHARED_TAIL = 1
    CompilerIf #Z80_TIMED = 1
      CompilerIf #Z80_ASM_TAIL = 1
        ASM Uses Z80Left
          mov r0, r11
          subs r0, #8
          mov r11, r0
          ble __ul_z80run_donecnt
        EndASM
      CompilerElse
        Z80Left = Z80Left - 8
        If Z80Left <= 0
          Goto DoneCnt
        EndIf
      CompilerEndIf
      Goto DispShared
    CompilerElse
      Goto NextShared
    CompilerEndIf
  CompilerElse
  CountInsn()
  CompilerIf #Z80_ASM_TAIL = 1
    CompilerIf #Z80_TIMED = 1
      ASM Uses Z80Left
        mov r0, r11
        subs r0, #8
        mov r11, r0
        ble __ul_z80run_done
      EndASM
    CompilerElse
      ASM Uses Z80Left
        mov r0, r11
        subs r0, #1
        mov r11, r0
        beq __ul_z80run_done
      EndASM
    CompilerEndIf
  CompilerElse
    CompilerIf #Z80_TIMED = 1
