Macro DispatchBase()
  CompilerIf #Z80_ASM_TAIL = 1
    ASM Uses Z80PC
      ldr r1, =global_z80mem
      ldrb r2, [r1, r4]
      adds r4, #1
      uxth r4, r4
      lsls r2, r2, #2
      ldr r1, =global_z80opbase
      ldr r1, [r1, r2]
      bx r1
    EndASM
  CompilerElse
    op = Z80Mem(Z80PC)
    Z80PC = (Z80PC + 1) & $FFFF
    Goto Z80OpBase(op)
  CompilerEndIf
EndMacro
