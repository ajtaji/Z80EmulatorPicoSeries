        Goto Done
      EndIf
    CompilerElse
      Z80Left = Z80Left - 1
      If Z80Left = 0
        Goto Done
      EndIf
    CompilerEndIf
  CompilerEndIf
  DispatchBase()
  CompilerEndIf
Op00: ; NOP
