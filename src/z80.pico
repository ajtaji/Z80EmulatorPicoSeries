Done:
  If Z80Saved <> 0
    ; End of an EI window split: give back the budget and sample interrupts.
    CompilerIf #Z80_Q = 1
      If qm = Z80Left
        qm = Z80Left + Z80Saved
      Else
        qm = #Z80_QNONE
      EndIf
    CompilerEndIf
    Z80Left = Z80Left + Z80Saved
    Z80Saved = 0
    If Z80Stopped = 0
      If Z80Left > 0
        Goto Resume
      EndIf
    EndIf
  EndIf
  CompilerIf #Z80_Q = 1
    If qm = Z80Left
      Z80QLast = 1
    Else
      Z80QLast = 0
    EndIf
  CompilerEndIf
  t = Z80Budget - Z80Left
  CompilerIf #Z80_TIMED = 1
    Z80TStates = Z80TStates + t
    Z80RCnt = Z80RCnt + Z80ICount
    Z80ICount = 0
  CompilerElse
    Z80RCnt = Z80RCnt + t
  CompilerEndIf
  ProcedureReturn t
EndProcedure

